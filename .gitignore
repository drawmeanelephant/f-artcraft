# installed app binaries and release tarballs (reinstallable, huge)
app/
*.tar.gz
# scratch renders (deliverables live at top level, twitter/, muse/)
work/out/
__pycache__/
# app window proof screenshots
*window*.png
*.log
.DS_Store

# local archive: pdf proofs stay out of git (see AGENTS.md).
# natives ship with their plate so any checkout can open them in the app —
# but scratch natives in work/out/ stay ignored.
*.vectorcraft
# PNG exports live on the media branch to keep clones small:
# git checkout media || git worktree add media
*@2x.png
*.designcraft
*.figcraft
!art/**/*.vectorcraft
!test/**/*.vectorcraft
# virelai/design sheets commit their native alongside the exports
!virelai/**/*.vectorcraft
!virelai/**/*.figcraft
!virelai/**/*.designcraft
pdf/
# T3 agent scratch workspaces
t3-*/
# generated site + data — rebuilt by docs/gen_data.py + docs/build.sh on
# every deploy; main is protected so generated output stays untracked.
docs/site/
docs/data/
